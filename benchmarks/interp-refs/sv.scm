(define (sieve-once)
  (let ((flags (make-vector 5000 #t)) (count 0))
    (do ((i 2 (+ i 1))) ((> i 5000))
      (when (vector-ref flags (- i 1))
        (set! count (+ count 1))
        (do ((k (+ i i) (+ k i))) ((> k 5000))
          (vector-set! flags (- k 1) #f))))
    count))
(define (rep n r) (if (= n 0) r (rep (- n 1) (sieve-once))))
(display (rep 1000 0)) (newline)
