(define (mandelbrot size)
  (let ((sum 0) (byte-acc 0) (bit-num 0))
    (do ((y 0 (+ y 1))) ((= y size))
      (let ((ci (- (/ (* 2.0 y) size) 1.0)))
        (do ((x 0 (+ x 1))) ((= x size))
          (let ((zrzr 0.0) (zi 0.0) (zizi 0.0) (cr (- (/ (* 2.0 x) size) 1.5))
                (z 0) (not-done #t) (escape 0))
            (do () ((not (and not-done (< z 50))))
              (let ((zr (+ (- zrzr zizi) cr)))
                (set! zi (+ (* 2.0 zr zi) ci))
                (set! zrzr (* zr zr))
                (set! zizi (* zi zi))
                (if (> (+ zrzr zizi) 4.0) (begin (set! not-done #f) (set! escape 1)))
                (set! z (+ z 1))))
            (set! byte-acc (+ (* byte-acc 2) escape))
            (set! bit-num (+ bit-num 1))
            (cond ((= bit-num 8)
                   (set! sum (logxor sum byte-acc)) (set! byte-acc 0) (set! bit-num 0))
                  ((= x (- size 1))
                   (set! byte-acc (* byte-acc (expt 2 (- 8 bit-num))))
                   (set! sum (logxor sum byte-acc)) (set! byte-acc 0) (set! bit-num 0)))))))
    sum))
(display (mandelbrot 500)) (newline)
