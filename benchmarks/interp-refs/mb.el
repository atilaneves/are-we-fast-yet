;;; -*- lexical-binding: t -*-
(defun mandelbrot (size)
  (let ((sum 0) (byte-acc 0) (bit-num 0) (y 0))
    (while (< y size)
      (let ((ci (- (/ (* 2.0 y) size) 1.0)) (x 0))
        (while (< x size)
          (let ((zrzr 0.0) (zi 0.0) (zizi 0.0) (cr (- (/ (* 2.0 x) size) 1.5))
                (z 0) (not-done t) (escape 0))
            (while (and not-done (< z 50))
              (let ((zr (+ (- zrzr zizi) cr)))
                (setq zi (+ (* 2.0 zr zi) ci))
                (setq zrzr (* zr zr))
                (setq zizi (* zi zi))
                (when (> (+ zrzr zizi) 4.0) (setq not-done nil escape 1))
                (setq z (1+ z))))
            (setq byte-acc (+ (* byte-acc 2) escape))
            (setq bit-num (1+ bit-num))
            (cond ((= bit-num 8)
                   (setq sum (logxor sum byte-acc) byte-acc 0 bit-num 0))
                  ((= x (1- size))
                   (setq byte-acc (ash byte-acc (- 8 bit-num)))
                   (setq sum (logxor sum byte-acc) byte-acc 0 bit-num 0))))
          (setq x (1+ x))))
      (setq y (1+ y)))
    sum))
(princ (mandelbrot 500)) (terpri)
